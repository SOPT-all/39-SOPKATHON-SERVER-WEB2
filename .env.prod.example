# GitHub Secrets의 ENV_PROD에 아래 내용을 값만 바꿔 그대로 등록
# CD가 배포 시 .env를 생성해 EC2(~/sopkathon/.env)로 전송하며, DOCKERHUB_USERNAME, IMAGE_TAG는 자동으로 추가됨
SPRING_PROFILES_ACTIVE=prod
DB_HOST=YOUR_RDS_ENDPOINT.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=sopkathon
DB_USERNAME=
DB_PASSWORD=
DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# S3 자격 증명은 EC2에 연결된 IAM Role로 처리하므로 액세스 키는 넣지 않음
AWS_REGION=ap-northeast-2
S3_BUCKET=YOUR_S3_BUCKET
