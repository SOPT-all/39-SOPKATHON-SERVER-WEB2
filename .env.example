# GitHub Secrets의 ENV_PROD에 아래 내용을 값만 바꿔 그대로 등록
# CD가 배포 시 .env를 생성해 EC2(~/sopkathon/.env)로 전송하며, DOCKERHUB_USERNAME은 자동으로 추가됨
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT.ap-northeast-2.rds.amazonaws.com:3306/sopkathon?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=
DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
